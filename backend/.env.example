# ──────────────────────────────────────────────────────────────
# Flux Backend Environment Configuration
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file to version control.
# ──────────────────────────────────────────────────────────────

# Port the Express server listens on (default: 4000)
PORT=4000

# MongoDB connection URI (required for database features)
# Example: mongodb+srv://user:pass@cluster.mongodb.net/flux?retryWrites=true&w=majority
MONGO_URI=

# Secret used to sign JWTs (required for auth features)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed CORS origins.
# If omitted, a sensible default set is used.
ALLOWED_ORIGINS=https://flux.org.in,https://www.flux.org.in

# Optional URL to ping every 10 minutes (Render free-tier keep-alive)
SELF_PING_URL=https://flux-backend-1hmq.onrender.com/ping

# ── Supabase (file uploads) ────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_PPTS=ideathon_ppts
SUPABASE_BUCKET_PHOTOS=ideathon_photos

# ── Cloudinary (legacy, currently unused) ──────────────────────
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
CLOUD_PRESET=

# ── ByteBrawl Database (Supabase PostgreSQL via Prisma) ─────────
# Direct: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Pooler (Vercel Serverless): postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Admin token to access /api/admin/registrations and /api/admin/registrations.csv
ADMIN_TOKEN=flux-admin-secret-2026

# Optional allowed email domains comma-separated (empty = allow any domain)
ALLOWED_EMAIL_DOMAINS=

# ── SMTP Email Notifications (Nodemailer) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FLUX MMMUT <noreply@mmmut.ac.in>"